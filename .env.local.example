# ================================================================
# ধোঁয়া-মুক্ত পথ — Environment Variables (example)
#
# এর ব্যবহার:
#   cp .env.local.example .env.local
# তারপর .env.local খুলে বাস্তব মান বসান।
#
# NEXT_PUBLIC_ prefix থাকা সব variables ব্রাউজার-এ পাठানো হয় — কোনো
# গোপন মান (API secret, password) এখানে রাখবেন না। শুধু public-safe
# config (phone number, price, analytics id) রাখুন।
# ================================================================

# --- Site ---
# Your production URL (no trailing slash).
# Development-এ এতে http://localhost:3000 দিতে পারেন।
NEXT_PUBLIC_SITE_URL=https://smoke-free-path.pages.dev

# --- Contact / Payment numbers ---
# বাংলাদেশি mobile format: 11 digits, শুরু 01 দিয়ে।
# এগুলোই bKash/Nagad Personal/Merchant নম্বর।
NEXT_PUBLIC_BKASH_NUMBER=01977752579
NEXT_PUBLIC_NAGAD_NUMBER=01977752579
NEXT_PUBLIC_WHATSAPP_NUMBER=01977752579

# --- Support / Order email ---
# Inbox এ order confirmation এবং support message forward হয়।
NEXT_PUBLIC_SUPPORT_EMAIL=niyyah369app@gmail.com
NEXT_PUBLIC_ORDER_EMAIL=niyyah369app@gmail.com

# --- Pricing (BDT) ---
NEXT_PUBLIC_BUNDLE_PRICE=369
NEXT_PUBLIC_ORIGINAL_PRICE=963
NEXT_PUBLIC_CUSTOMER_LIMIT=963

# --- Order submission endpoint (Cloudflare Worker) ---
# এই URL-এ Worker deploy করলে, checkout form সরাসরি এখানে POST করবে।
# না দিলে code স্বয়ংক্রিয় mailto: fallback-এ চলে যাবে (NEXT_PUBLIC_ORDER_EMAIL-এ)।
# উদাহরণ: https://sfp-order-handler.<your-subdomain>.workers.dev
NEXT_PUBLIC_ORDER_WORKER_URL=

# --- Analytics (optional) ---
# ব্ল্যাঙ্ক রাখলে এই script gulo render hobe na (layout.tsx-এ conditional check আছে)।
# Cloudflare Web Analytics token পাবেন: dash.cloudflare.com → Analytics & Logs → Web Analytics
NEXT_PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN=
NEXT_PUBLIC_CLARITY_ID=
