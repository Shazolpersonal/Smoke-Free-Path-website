  "source": "Abbar Kotha (আব্বার কথা) — Spoken Memoir by তানভির হাসান (Shazolpersonal). In loving memory of আব্দুল করিম (রহঃ).",
  "chapters": [
    { "id": "intro", "title": "সালাম", "start": 0, "end": 8 },
    { "id": "father", "title": "আব্বার গল্প", "start": 8, "end": 45 },
    { "id": "truth", "title": "সিগারেটের সত্য", "start": 45, "end": 85 },
    { "id": "quran", "title": "কুরআনের আয়াত", "start": 85, "end": 150 },
    { "id": "solution", "title": "৩টি অ্যাপ", "start": 150, "end": 170 },
    { "id": "promise", "title": "৪১ দিন প্রতিশ্রুতি", "start": 170, "end": 195 },
    { "id": "dua", "title": "দুআ", "start": 195, "end": 207.65 }
  ],
  "lines": [
    { "t": 0.0, "d": 3.5, "text": "আসসালামু আলাইকুম, ভাই।" },
    { "t": 3.5, "d": 4.5, "text": "একটু সময় দিবেন?" },
    { "t": 8.0, "d": 4.0, "text": "আমার আব্বা — আব্দুল করিম।" },
    { "t": 12.0, "d": 4.0, "text": "একজন সাধারণ মানুষ, সৎ মানুষ।" },
    { "t": 16.0, "d": 6.0, "text": "চুয়াল্লিশ বছর বয়সে ধরা পড়ে স্টেজ-ফোর লাং ক্যান্সার।" },
    { "t": 22.0, "d": 5.0, "text": "কারণ ছিল একটাই — সিগারেট।" },
    { "t": 27.0, "d": 7.0, "text": "একচল্লিশ দিন হাসপাতালে কাটিয়ে..." },
    { "t": 34.0, "d": 6.0, "text": "আমাদের রেখে চলে গেলেন তিনি।" },
    { "t": 40.0, "d": 5.0, "text": "إِنَّا لِلَّهِ وَإِنَّا إِلَيْهِ رَاجِعُونَ", "arabic": true },
    { "t": 45.0, "d": 5.0, "text": "সিগারেট তাকে শেষ করেছে, ভাই।" },
    { "t": 50.0, "d": 6.0, "text": "শুধু তাঁকে না — প্রতি বছর বাংলাদেশে..." },
    { "t": 56.0, "d": 6.0, "text": "এক লক্ষ ষাট হাজার মানুষকে শেষ করে।" },
    { "t": 62.0, "d": 5.0, "text": "এটা পরিসংখ্যান নয়, ভাই।" },
    { "t": 67.0, "d": 5.0, "text": "এরা প্রত্যেকে কারো আব্বা।" },
    { "t": 72.0, "d": 6.0, "text": "কারো স্বামী। কারো প্রিয় ছেলে।" },
    { "t": 78.0, "d": 7.0, "text": "আর আমাদের সন্তানরা অপেক্ষা করছে।" },
    { "t": 85.0, "d": 6.0, "text": "আমি কোড লিখতে জানি।" },
    { "t": 91.0, "d": 6.0, "text": "কিন্তু আব্বাকে ফিরিয়ে আনতে পারিনি।" },
    { "t": 97.0, "d": 7.0, "text": "তাই আল্লাহর কাছে প্রার্থনা করেছি —" },
    { "t": 104.0, "d": 6.0, "text": "অন্য কাউকে যেন বাঁচাতে পারি।" },
    { "t": 110.0, "d": 7.0, "text": "আর তিনটা অ্যাপ বানিয়েছি —" },
    { "t": 117.0, "d": 6.0, "text": "যেন আর কারো সন্তান এই কষ্ট না পায়।" },
    { "t": 123.0, "d": 6.0, "text": "وَلَا تُلْقُوا بِأَيْدِيكُمْ إِلَى التَّهْلُكَةِ", "arabic": true },
    { "t": 129.0, "d": 7.0, "text": "আল্লাহ বলেছেন — সূরা বাকারা, আয়াত ১৯৫।" },
    { "t": 136.0, "d": 8.0, "text": "নিজের হাতে নিজেকে ধ্বংসের দিকে ঠেলে দিও না।" },
    { "t": 144.0, "d": 6.0, "text": "এর চেয়ে স্পষ্ট আয়াত আর নেই, ভাই।" },
    { "t": 150.0, "d": 7.0, "text": "তিনশো উনসত্তর টাকা। একবার মাত্র।" },
    { "t": 157.0, "d": 5.0, "text": "সারা জীবনের জন্য।" },
    { "t": 162.0, "d": 8.0, "text": "প্রথম নয়শো তেষট্টি জন ভাইয়ের জন্য।" },
    { "t": 170.0, "d": 8.0, "text": "একচল্লিশ দিনে কাজ না হলে — পুরো টাকা ফেরত।" },
    { "t": 178.0, "d": 5.0, "text": "ওয়াদা। আল্লাহর নামে ওয়াদা।" },
    { "t": 183.0, "d": 4.0, "text": "এটা ব্যবসা নয়।" },
    { "t": 187.0, "d": 8.0, "text": "এটা একজন ছেলের তার বাবার প্রতি ভালোবাসা।" },
    { "t": 195.0, "d": 6.0, "text": "ভাই, আজ রাতে একবার ভাবুন।" },
    { "t": 201.0, "d": 4.0, "text": "দুআ করবেন আব্বার জন্য।" },
    { "t": 205.0, "d": 2.65, "text": "আল্লাহ হাফিজ।" }
  ]
}
